[Desktop Entry]
Version=1.1
Type=Application
Name=Mise à jour apt-notifier
Comment=Réactivation de l’icône MX Mise à jour même si aucune mise à jour n’est disponible
Icon=apt-notifier
Exec=/usr/bin/apt-notifier-unhide-Icon
Actions=
Categories=KDE;Qt;System;Utility;X-KDE-Utilities-Desktop;
Keywords=apt;update;upgrade;notifier;
StartupWMClass=apt-notifier
