[Desktop Entry]
Version=1.1
Type=Application
Name=Réparation des clés GPG - MX Fix GPG keys
GenericName=Vérifier et installer les clés GPG manquantes pour apt
Comment=Vérifier et installer les clés GPG manquantes pour apt
Icon=checkaptgpg
Exec=pkexec checkaptgpg --wait-at-end
Terminal=true
Actions=
Categories=MX-Software;PackageManager;System;
Keywords=apt;fix;check;gpg;keys;clés;vérifier;corriger;
