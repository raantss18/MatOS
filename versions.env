# matOS — source unique de vérité pour toutes les versions figées.
# Toute ressource téléchargée pendant le build est vérifiée par SHA256 :
# si l'amont change ou disparaît, le build échoue au lieu de produire
# une image incomplète. Pour mettre à jour : changer version + URL + SHA256.
#
# MATOS_MIRROR : miroir matOS (release GitHub « sources ») tenté en premier
# s'il est défini ; les URL amont servent de repli.

MATOS_VERSION=0.6
MATOS_CODENAME=ralambo
MATOS_NAME="matOS RALAMBO"
MATOS_URL=https://github.com/raantss18/MatOS
MATOS_MIRROR=
# Dépôt APT matOS (mises à jour des paquets matos-*). Activé dans l'image
# seulement si la clé publique keys/matos-archive-keyring.gpg existe.
MATOS_APT_URL=https://github.com/raantss18/MatOS/releases/download/depot

# ── Base Debian ─────────────────────────────────────────────────────────
DEBIAN_SUITE=trixie
# Instantané snapshot.debian.org pour un build reproductible
# (ex. 20261101T000000Z). Vide = miroir Debian courant.
DEBIAN_SNAPSHOT=
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://security.debian.org/debian-security

# ── SageMath + Python scientifique (conda-forge, figé) ──────────────────
# La liste exacte des paquets est dans packages/matos-sagemath/environment.lock
MICROMAMBA_VERSION=2.10.0-0
MICROMAMBA_URL=https://github.com/mamba-org/micromamba-releases/releases/download/2.10.0-0/micromamba-linux-64
MICROMAMBA_SHA256=701f39c06f8e6a670a0e186c8479b9e5c0502a2f0cda6cef65d83bdd2875e8bd
SAGE_VERSION=10.9

# ── Lean 4 + Mathlib ────────────────────────────────────────────────────
ELAN_VERSION=4.2.4
ELAN_URL=https://github.com/leanprover/elan/releases/download/v4.2.4/elan-x86_64-unknown-linux-gnu.tar.gz
ELAN_SHA256=42b94d4244e8353142c456ec0e4ca6528fd898a6c604d4059f494e706e431f63
LEAN_TOOLCHAIN=leanprover/lean4:v4.35.0
MATHLIB_REV=v4.35.0
MATHLIB_GIT=https://github.com/leanprover-community/mathlib4.git

