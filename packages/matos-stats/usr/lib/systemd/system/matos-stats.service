[Unit]
Description=matOS - statistiques anonymes (au plus un envoi par jour)
Documentation=man:matos-stats
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/lib/matos/stats-endpoint

[Service]
Type=oneshot
ExecStart=/usr/bin/matos-stats --envoyer
DynamicUser=yes
StateDirectory=matos-stats
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
