# matOS — écran de démarrage Plymouth (module script)
# Gère aussi la saisie de phrase de passe (disque chiffré) et les messages.

Window.SetBackgroundTopColor(0.05, 0.07, 0.12);
Window.SetBackgroundBottomColor(0.07, 0.04, 0.14);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

tick = 0;
fun refresh_callback() {
    tick++;
    logo.sprite.SetOpacity(0.65 + 0.35 * Math.Sin(tick / 25));
}
Plymouth.SetRefreshFunction(refresh_callback);

prompt.sprite = Sprite();
bullets.sprite = Sprite();
message.sprite = Sprite();

fun show_centered(sprite, image, y) {
    sprite.SetImage(image);
    sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - image.GetWidth() / 2);
    sprite.SetY(y);
    sprite.SetZ(10);
    sprite.SetOpacity(1);
}

fun display_password_callback(text, count) {
    base_y = Window.GetY() + Window.GetHeight() * 0.72;
    show_centered(prompt.sprite, Image.Text(text, 0.94, 0.96, 0.97), base_y);
    stars = "";
    for (i = 0; i < count; i++) stars += "* ";
    if (stars == "") stars = " ";
    show_centered(bullets.sprite, Image.Text(stars, 0.0, 0.79, 0.65), base_y + 30);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(text, entry) {
    base_y = Window.GetY() + Window.GetHeight() * 0.72;
    show_centered(prompt.sprite, Image.Text(text, 0.94, 0.96, 0.97), base_y);
    show_centered(bullets.sprite, Image.Text(entry + " ", 0.0, 0.79, 0.65), base_y + 30);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback(text) {
    show_centered(message.sprite, Image.Text(text, 0.8, 0.8, 0.8),
                  Window.GetY() + Window.GetHeight() * 0.9);
}
Plymouth.SetMessageFunction(message_callback);
