#!/bin/sh
# Ouvre l'encyclopédie hors ligne dans le navigateur. kiwix-serve n'écoute que sur
# cette machine (127.0.0.1) ; il est lancé à la première ouverture de la session.
set -eu
port=8473
if ! curl -fs -o /dev/null "http://127.0.0.1:$port/"; then
    setsid kiwix-serve --address 127.0.0.1 --port "$port" /opt/matos/encyclopedie/*.zim >/dev/null 2>&1 &
    i=0
    until curl -fs -o /dev/null "http://127.0.0.1:$port/" || [ $i -ge 20 ]; do sleep 0.5; i=$((i + 1)); done
fi
exec xdg-open "http://127.0.0.1:$port/"
