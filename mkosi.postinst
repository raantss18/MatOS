#!/bin/bash
set -euo pipefail

# ── Gestionnaire d'affichage ────────────────────────────────────────
systemctl enable lightdm
systemctl enable NetworkManager
systemctl enable bluetooth

# ── Utilisateur par défaut ──────────────────────────────────────────
if ! id matos &>/dev/null; then
    useradd -m -s /bin/bash -G sudo,audio,video,plugdev,netdev matos
fi
echo "matos:matos" | chpasswd

# ── Autologin LightDM ───────────────────────────────────────────────
mkdir -p /etc/lightdm/lightdm.conf.d/
cat > /etc/lightdm/lightdm.conf.d/50-matos.conf << 'EOF'
[Seat:*]
autologin-user=matos
autologin-user-timeout=0
user-session=xfce
EOF

# ── Hôte et langue ───────────────────────────────────────────────────
echo "matos" > /etc/hostname
echo "fr_FR.UTF-8 UTF-8" >> /etc/locale.gen
locale-gen

# ── Plymouth (écran de démarrage matOS) ──────────────────────────────
if command -v plymouth-set-default-theme &>/dev/null; then
    plymouth-set-default-theme -R matos 2>/dev/null || \
    plymouth-set-default-theme -R bgrt 2>/dev/null || \
    plymouth-set-default-theme -R solar || true
fi

# ── Dépôt MX Linux 25 (Trixie) ──────────────────────────────────────
mkdir -p /etc/apt/sources.list.d/
echo "deb http://mxrepo.com/mx/repo/ trixie main" > /etc/apt/sources.list.d/mx.list

# ── Dépôts Flatpak ───────────────────────────────────────────────────
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || true

# ── Service de nettoyage live au premier démarrage ───────────────────
cat > /etc/systemd/system/live-cleanup.service << 'EOF'
[Unit]
Description=Suppression des paquets live apres installation
ConditionPathExists=/var/lib/live-cleanup-pending
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c '\
    apt-get purge -y live-boot live-boot-initramfs-tools live-config \
        live-config-systemd live-tools calamares calamares-settings-debian && \
    apt-get autoremove -y && \
    rm -f /var/lib/live-cleanup-pending'

[Install]
WantedBy=multi-user.target
EOF

# Marquer le nettoyage comme en attente (sera exécuté après installation via Calamares)
# Le fichier sentinel est créé ici ; Calamares le laisse en place après installation.
# Sur un système live (non installé), le service s'exécute mais le fichier n'existe pas.
touch /var/lib/live-cleanup-pending
systemctl enable live-cleanup.service || true

echo "matOS RALAMBO — post-installation terminée avec succès."
